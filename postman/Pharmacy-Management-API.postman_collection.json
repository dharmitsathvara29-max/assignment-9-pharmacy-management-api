{
  "info": {
    "_postman_id": "pharmacy-management-api-assignment-09",
    "name": "Pharmacy Management API - Assignment 09",
    "description": "Comprehensive Postman collection for Pharmacy & Healthcare Store REST API with RBAC & JWT.\nCovers Customer, Pharmacist, and Admin roles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001" },
    { "key": "adminKey", "value": "admin_pharmacy_secret_key_2026" },
    { "key": "customerToken", "value": "" },
    { "key": "pharmacistToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "medicineId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication & RBAC Setup",
      "item": [
        {
          "name": "Register Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('customerToken', res.token);",
                  "    console.log('Customer token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Customer\",\n  \"email\": \"customer@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register" }
          }
        },
        {
          "name": "Register Pharmacist (Admin Key)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('pharmacistToken', res.token);",
                  "    console.log('Pharmacist token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Pharmacist\",\n  \"email\": \"pharmacist@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"pharmacist\",\n  \"adminKey\": \"{{adminKey}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register-staff" }
          }
        },
        {
          "name": "Register Admin (Admin Key)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('adminToken', res.token);",
                  "    console.log('Admin token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carol Admin\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"admin\",\n  \"adminKey\": \"{{adminKey}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register-staff" }
          }
        },
        {
          "name": "Login - Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) pm.collectionVariables.set('customerToken', res.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login" }
          }
        },
        {
          "name": "Get Profile (Customer)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/profile" }
          }
        },
        {
          "name": "Get Profile (Pharmacist)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{pharmacistToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/profile" }
          }
        },
        {
          "name": "Get Profile (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/profile" }
          }
        }
      ]
    },
    {
      "name": "2. Medicine Inventory Management",
      "item": [
        {
          "name": "Browse All Medicines (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/medicines" }
          }
        },
        {
          "name": "Search & Filter Medicines (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/medicines?search=Paracetamol&category=Analgesic" }
          }
        },
        {
          "name": "RBAC Check: Customer Attempts Add Medicine (Expect 403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amoxicillin 500mg\",\n  \"brand\": \"PharmaBrand\",\n  \"category\": \"Antibiotic\",\n  \"dosageForm\": \"Capsule\",\n  \"price\": 30,\n  \"stockQuantity\": 50,\n  \"requiresPrescription\": true,\n  \"expiryDate\": \"2026-10-15T00:00:00.000Z\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/medicines" }
          }
        },
        {
          "name": "Add Medicine (Pharmacist)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.medicine && res.medicine._id) {",
                  "    pm.collectionVariables.set('medicineId', res.medicine._id);",
                  "    console.log('Saved medicineId:', res.medicine._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{pharmacistToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Paracetamol 500mg\",\n  \"brand\": \"PharmaCare\",\n  \"category\": \"Analgesic\",\n  \"dosageForm\": \"Tablet\",\n  \"price\": 25,\n  \"stockQuantity\": 100,\n  \"requiresPrescription\": false,\n  \"expiryDate\": \"2027-12-31T00:00:00.000Z\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/medicines" }
          }
        },
        {
          "name": "Add Expiring Medicine (Pharmacist)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{pharmacistToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cough Syrup Junior\",\n  \"brand\": \"ColdRelief\",\n  \"category\": \"Antitussive\",\n  \"dosageForm\": \"Syrup\",\n  \"price\": 45,\n  \"stockQuantity\": 8,\n  \"requiresPrescription\": false,\n  \"expiryDate\": \"2026-10-10T00:00:00.000Z\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/medicines" }
          }
        },
        {
          "name": "Get Medicine by ID (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/medicines/{{medicineId}}" }
          }
        },
        {
          "name": "Update Stock & Price (Pharmacist)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{pharmacistToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 28,\n  \"stockQuantity\": 120\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/medicines/{{medicineId}}" }
          }
        },
        {
          "name": "Expiring Medicines (Pharmacist)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{pharmacistToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/medicines/expiring" }
          }
        },
        {
          "name": "RBAC Check: Pharmacist Attempts Delete Drug (Expect 403)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{pharmacistToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/medicines/{{medicineId}}" }
          }
        },
        {
          "name": "Delete Medicine (Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/medicines/{{medicineId}}" }
          }
        }
      ]
    },
    {
      "name": "3. Orders & Prescriptions",
      "item": [
        {
          "name": "Place Order (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.order && res.order._id) {",
                  "    pm.collectionVariables.set('orderId', res.order._id);",
                  "    console.log('Saved orderId:', res.order._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"medicine\": \"{{medicineId}}\",\n      \"quantity\": 2\n    }\n  ],\n  \"prescriptionNotes\": \"Over-the-counter customer request\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders" }
          }
        },
        {
          "name": "View My Orders (Customer)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders/my-orders" }
          }
        },
        {
          "name": "List All Orders (Pharmacist / Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{pharmacistToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders" }
          }
        },
        {
          "name": "Get Single Order (Customer / Staff)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}" }
          }
        },
        {
          "name": "Approve Order & Deduct Stock (Pharmacist)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{pharmacistToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}/status" }
          }
        },
        {
          "name": "Dispense Order (Pharmacist)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{pharmacistToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"dispensed\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}/status" }
          }
        }
      ]
    },
    {
      "name": "4. Reports & Aggregations",
      "item": [
        {
          "name": "Expiring Soon Drugs Report (Pharmacist / Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{pharmacistToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/reports/expiring-soon?days=30" }
          }
        },
        {
          "name": "Low Stock Inventory Alerts (Pharmacist / Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{pharmacistToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/reports/low-stock?threshold=10" }
          }
        },
        {
          "name": "Inventory Summary Analytics (Pharmacist / Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{pharmacistToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/reports/summary" }
          }
        }
      ]
    }
  ]
}
